{
  "method": "dsagent.executions.running.list",
  "version": 1,
  "title": "List running executions",
  "description": "List pending and running execution summaries assigned to the current extension instance.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workflowId": {
        "type": "string",
        "maxLength": 128,
        "description": "Optional opaque workflow ID used to restrict active executions."
      }
    },
    "additionalProperties": false,
    "description": "Optional workflow filter for active executions."
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "records": {
        "type": "array",
        "maxItems": 100,
        "description": "Bounded execution summaries.",
        "items": {
          "type": "object",
          "properties": {
            "executionId": {
              "type": "string",
              "maxLength": 128,
              "description": "Opaque workflow execution identifier."
            },
            "workflowId": {
              "type": "string",
              "maxLength": 128,
              "description": "Opaque workflow identifier."
            },
            "workflowName": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional workflow display name."
            },
            "status": {
              "type": "string",
              "maxLength": 100,
              "description": "Current execution lifecycle status. partial: ended through the agent repair handoff after saving rows (terminal)."
            },
            "startedAt": {
              "type": "string",
              "maxLength": 100,
              "description": "Optional execution start timestamp."
            },
            "finishedAt": {
              "type": "string",
              "maxLength": 100,
              "description": "Optional execution finish timestamp."
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional execution duration in milliseconds."
            },
            "error": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional bounded execution error summary."
            }
          },
          "required": [
            "executionId",
            "workflowId",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0,
        "description": "Total matching execution count."
      }
    },
    "required": [
      "records",
      "total"
    ],
    "additionalProperties": false,
    "description": "Pending and running executions assigned to this Extension instance."
  },
  "risk": "read-sensitive",
  "targetKinds": [
    "workflow"
  ],
  "requiredPermissions": [
    "workflow.read"
  ],
  "timeoutMs": 10000,
  "maxInlineResultBytes": 262144,
  "concurrency": "shared-read",
  "retry": "pre-dispatch-read-only",
  "exposure": "exposed"
}
