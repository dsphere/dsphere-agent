{
  "method": "dsagent.workflows.list",
  "version": 1,
  "title": "List workflows",
  "description": "List workflows visible to the current extension identity.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 200,
        "description": "Optional workflow name or metadata search text."
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000,
        "description": "One-based result page; defaults to 1."
      },
      "pageSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Maximum records per page; defaults to 50."
      }
    },
    "additionalProperties": false,
    "description": "Filters and pagination for workflows visible to the current Extension identity."
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "records": {
        "type": "array",
        "maxItems": 100,
        "description": "Records in the requested page.",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128,
              "description": "Opaque workflow identifier used by workflow and execution capabilities."
            },
            "name": {
              "type": "string",
              "maxLength": 500,
              "description": "Workflow display name."
            },
            "description": {
              "type": "string",
              "maxLength": 2000,
              "description": "Optional workflow description."
            },
            "folder": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional workflow folder label."
            },
            "tags": {
              "type": "array",
              "maxItems": 20,
              "description": "Optional bounded workflow tags.",
              "items": {
                "type": "string",
                "maxLength": 200,
                "description": "One workflow tag."
              }
            },
            "updatedAt": {
              "type": "string",
              "maxLength": 100,
              "description": "Optional last-update timestamp supplied by the backend."
            },
            "currentDefinitionVersion": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional current workflow definition version."
            },
            "nodeCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional workflow node count."
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0,
        "description": "Total matching record count."
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000,
        "description": "One-based page returned."
      },
      "pageSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Requested maximum records per page."
      }
    },
    "required": [
      "records",
      "total",
      "page",
      "pageSize"
    ],
    "additionalProperties": false,
    "description": "Paginated workflows visible to the current Extension identity."
  },
  "risk": "read-sensitive",
  "targetKinds": [
    "workflow"
  ],
  "requiredPermissions": [
    "workflow.read"
  ],
  "timeoutMs": 10000,
  "maxInlineResultBytes": 262144,
  "concurrency": "shared-read",
  "retry": "pre-dispatch-read-only",
  "exposure": "exposed"
}
