{
  "method": "dsagent.accounts.list",
  "version": 1,
  "title": "List Accounts",
  "description": "Search the current Work-visible account snapshot.",
  "inputSchema": {
    "type": "object",
    "description": "Search the current Work-visible account snapshot.",
    "properties": {
      "appId": {
        "type": "string",
        "description": "Opaque application reference returned by accounts.options.get.",
        "minLength": 1,
        "maxLength": 100
      },
      "query": {
        "type": "string",
        "description": "Filter account/application names.",
        "maxLength": 200
      },
      "status": {
        "type": "string",
        "description": "Account enabled filter.",
        "minLength": 1,
        "maxLength": 200,
        "enum": [
          "all",
          "enabled",
          "disabled"
        ]
      },
      "page": {
        "type": "integer",
        "description": "Page number; default 1.",
        "minimum": 1,
        "maximum": 100000
      },
      "pageSize": {
        "type": "integer",
        "description": "Page size; default 50.",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "description": "Account operation result. status/stage are for internal reconciliation, not user-facing open-success/failure badges. Report the separate autofill receipt; a page being open never proves fill or sign-in.",
    "properties": {
      "autofill": {
        "type": "object",
        "description": "Separate Biz autofill receipt. Query accounts.operations.get with operationId while running; unknown must not be replayed. succeeded proves fill owner completion, never website sign-in.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Observed autofill state.",
            "maxLength": 40,
            "enum": [
              "running",
              "succeeded",
              "failed",
              "skipped",
              "unknown"
            ]
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "description": "Receipt observation time in milliseconds."
          },
          "reason": {
            "type": "string",
            "description": "Safe reason code; never credentials or page field values.",
            "maxLength": 120
          }
        },
        "required": [
          "status",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "operationId": {
        "type": "string",
        "description": "Local operation reference; not a Pangu request receipt.",
        "maxLength": 100
      },
      "status": {
        "type": "string",
        "description": "Observed operation status.",
        "maxLength": 40,
        "enum": [
          "not-dispatched",
          "waiting-user",
          "running",
          "succeeded",
          "partial",
          "failed",
          "cancelled",
          "outcome-unknown",
          "record-unavailable",
          "available"
        ]
      },
      "stage": {
        "type": "string",
        "description": "Completed or current account business stage.",
        "maxLength": 100
      },
      "accountId": {
        "type": "string",
        "description": "Account reference when known.",
        "maxLength": 100
      },
      "pageContextId": {
        "type": "string",
        "description": "Actual opened/focused page reference when known.",
        "maxLength": 100
      },
      "warnings": {
        "type": "array",
        "description": "Bounded warnings, including synchronization and unknown outcomes.",
        "items": {
          "type": "string",
          "description": "One safe product warning.",
          "maxLength": 500
        },
        "maxItems": 20
      },
      "data": {
        "type": "object",
        "description": "Only the selected account operation's public product fields.",
        "properties": {
          "records": {
            "type": "array",
            "description": "Visible account summaries in this bounded page.",
            "items": {
              "type": "object",
              "description": "Visible account summary; no password, cookie or internal tags.",
              "properties": {
                "accountId": {
                  "type": "string",
                  "description": "Account reference.",
                  "maxLength": 100
                },
                "appId": {
                  "type": "string",
                  "description": "Application reference.",
                  "maxLength": 100
                },
                "appName": {
                  "type": "string",
                  "description": "Application name.",
                  "maxLength": 200
                },
                "accountName": {
                  "type": "string",
                  "description": "Account name.",
                  "maxLength": 200
                },
                "accountType": {
                  "type": "string",
                  "description": "Source account type.",
                  "maxLength": 100
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether the account is enabled."
                },
                "allowedActions": {
                  "type": "array",
                  "description": "Operations allowed by the current source, permissions and state.",
                  "items": {
                    "type": "string",
                    "description": "Allowed account operation.",
                    "maxLength": 100,
                    "enum": [
                      "options.get",
                      "list",
                      "get",
                      "create",
                      "update",
                      "delete",
                      "set-enabled",
                      "open",
                      "close",
                      "focus",
                      "fingerprint.get",
                      "fingerprint.update",
                      "fingerprint.regenerate",
                      "operations.get",
                      "pages.list"
                    ]
                  },
                  "maxItems": 14
                },
                "unavailableReason": {
                  "type": "string",
                  "description": "Why some operations are unavailable.",
                  "maxLength": 300
                }
              },
              "required": [
                "accountId",
                "appId",
                "appName",
                "accountName",
                "accountType",
                "enabled",
                "allowedActions"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of matches within this Work-visible snapshot."
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "description": "Current page."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Current page size."
          },
          "paginationScope": {
            "type": "string",
            "description": "The result is bounded by the current Work-visible snapshot.",
            "maxLength": 2000,
            "enum": [
              "work-visible-snapshot"
            ]
          },
          "readAt": {
            "type": "string",
            "description": "Time this state was read.",
            "maxLength": 40
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "required": [
      "status",
      "stage",
      "warnings"
    ],
    "additionalProperties": false
  },
  "risk": "read-sensitive",
  "targetKinds": [
    "managed-account"
  ],
  "requiredPermissions": [
    "accounts.read"
  ],
  "timeoutMs": 30000,
  "maxInlineResultBytes": 65536,
  "concurrency": "shared-read",
  "retry": "pre-dispatch-read-only",
  "exposure": "exposed"
}
