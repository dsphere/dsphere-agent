{
  "method": "dsagent.accounts.get",
  "version": 1,
  "title": "Get Account",
  "description": "Read a currently visible account without its password or cookies.",
  "inputSchema": {
    "type": "object",
    "description": "Read a currently visible account without its password or cookies.",
    "properties": {
      "accountId": {
        "type": "string",
        "description": "Opaque account reference returned by accounts.list or accounts.get.",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "required": [
      "accountId"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "description": "Account operation result. status/stage are for internal reconciliation, not user-facing open-success/failure badges. Report the separate autofill receipt; a page being open never proves fill or sign-in.",
    "properties": {
      "autofill": {
        "type": "object",
        "description": "Separate Biz autofill receipt. Query accounts.operations.get with operationId while running; unknown must not be replayed. succeeded proves fill owner completion, never website sign-in.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Observed autofill state.",
            "maxLength": 40,
            "enum": [
              "running",
              "succeeded",
              "failed",
              "skipped",
              "unknown"
            ]
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "description": "Receipt observation time in milliseconds."
          },
          "reason": {
            "type": "string",
            "description": "Safe reason code; never credentials or page field values.",
            "maxLength": 120
          }
        },
        "required": [
          "status",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "operationId": {
        "type": "string",
        "description": "Local operation reference; not a Pangu request receipt.",
        "maxLength": 100
      },
      "status": {
        "type": "string",
        "description": "Observed operation status.",
        "maxLength": 40,
        "enum": [
          "not-dispatched",
          "waiting-user",
          "running",
          "succeeded",
          "partial",
          "failed",
          "cancelled",
          "outcome-unknown",
          "record-unavailable",
          "available"
        ]
      },
      "stage": {
        "type": "string",
        "description": "Completed or current account business stage.",
        "maxLength": 100
      },
      "accountId": {
        "type": "string",
        "description": "Account reference when known.",
        "maxLength": 100
      },
      "pageContextId": {
        "type": "string",
        "description": "Actual opened/focused page reference when known.",
        "maxLength": 100
      },
      "warnings": {
        "type": "array",
        "description": "Bounded warnings, including synchronization and unknown outcomes.",
        "items": {
          "type": "string",
          "description": "One safe product warning.",
          "maxLength": 500
        },
        "maxItems": 20
      },
      "data": {
        "type": "object",
        "description": "Only the selected account operation's public product fields.",
        "properties": {
          "account": {
            "type": "object",
            "description": "Visible account summary; no password, cookie or internal tags.",
            "properties": {
              "accountId": {
                "type": "string",
                "description": "Account reference.",
                "maxLength": 100
              },
              "appId": {
                "type": "string",
                "description": "Application reference.",
                "maxLength": 100
              },
              "appName": {
                "type": "string",
                "description": "Application name.",
                "maxLength": 200
              },
              "accountName": {
                "type": "string",
                "description": "Account name.",
                "maxLength": 200
              },
              "accountType": {
                "type": "string",
                "description": "Source account type.",
                "maxLength": 100
              },
              "enabled": {
                "type": "boolean",
                "description": "Whether the account is enabled."
              },
              "allowedActions": {
                "type": "array",
                "description": "Operations allowed by the current source, permissions and state.",
                "items": {
                  "type": "string",
                  "description": "Allowed account operation.",
                  "maxLength": 100,
                  "enum": [
                    "options.get",
                    "list",
                    "get",
                    "create",
                    "update",
                    "delete",
                    "set-enabled",
                    "open",
                    "close",
                    "focus",
                    "fingerprint.get",
                    "fingerprint.update",
                    "fingerprint.regenerate",
                    "operations.get",
                    "pages.list"
                  ]
                },
                "maxItems": 14
              },
              "unavailableReason": {
                "type": "string",
                "description": "Why some operations are unavailable.",
                "maxLength": 300
              }
            },
            "required": [
              "accountId",
              "appId",
              "appName",
              "accountName",
              "accountType",
              "enabled",
              "allowedActions"
            ],
            "additionalProperties": false
          },
          "remark": {
            "type": "string",
            "description": "Account remark.",
            "maxLength": 2000
          },
          "loginType": {
            "type": "string",
            "description": "Current login method.",
            "maxLength": 100
          },
          "syncEnabled": {
            "type": "boolean",
            "description": "Current synchronization setting."
          },
          "sessionKeepAlive": {
            "type": "boolean",
            "description": "Current session retention setting."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "required": [
      "status",
      "stage",
      "warnings"
    ],
    "additionalProperties": false
  },
  "risk": "read-sensitive",
  "targetKinds": [
    "managed-account"
  ],
  "requiredPermissions": [
    "accounts.read"
  ],
  "timeoutMs": 30000,
  "maxInlineResultBytes": 65536,
  "concurrency": "shared-read",
  "retry": "pre-dispatch-read-only",
  "exposure": "exposed"
}
