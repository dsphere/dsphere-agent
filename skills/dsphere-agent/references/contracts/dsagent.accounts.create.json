                                "type": "string",
                                "maxLength": 200,
                                "description": "English product text."
                              }
                            }
                          }
                        }
                      }
                    },
                    "children": {
                      "type": "array",
                      "description": "Individual configurable metrics inside a grouped field.",
                      "maxItems": 30,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "key",
                          "label",
                          "description",
                          "control",
                          "required"
                        ],
                        "properties": {
                          "key": {
                            "type": "string",
                            "maxLength": 100,
                            "description": "Canonical creation field key used when submitting the selected value."
                          },
                          "label": {
                            "type": "object",
                            "description": "Localized product text in Chinese and English.",
                            "additionalProperties": false,
                            "required": [
                              "zh",
                              "en"
                            ],
                            "properties": {
                              "zh": {
                                "type": "string",
                                "maxLength": 200,
                                "description": "Chinese product text."
                              },
                              "en": {
                                "type": "string",
                                "maxLength": 200,
                                "description": "English product text."
                              }
                            }
                          },
                          "description": {
                            "type": "string",
                            "maxLength": 1000,
                            "description": "Field meaning, permission conditions and selection guidance for the agent."
                          },
                          "control": {
                            "type": "string",
                            "description": "Product control type; private values are entered separately in the trusted credential window.",
                            "enum": [
                              "text",
                              "select",
                              "multiselect",
                              "boolean",
                              "private",
                              "group",
                              "override"
                            ]
                          },
                          "required": {
                            "type": "boolean",
                            "description": "Whether this field requires a value under the current application policy."
                          },
                          "allowCustom": {
                            "type": "boolean",
                            "description": "Whether values outside the listed choices may be entered."
                          },
                          "allowEmpty": {
                            "type": "boolean",
                            "description": "Whether an explicitly empty value is permitted."
                          },
                          "help": {
                            "type": "object",
                            "description": "Localized help for choosing or entering the field value.",
                            "additionalProperties": false,
                            "required": [
                              "zh",
                              "en"
                            ],
                            "properties": {
                              "zh": {
                                "type": "string",
