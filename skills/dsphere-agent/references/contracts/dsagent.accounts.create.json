{
  "method": "dsagent.accounts.create",
  "version": 1,
  "title": "Create Account",
  "description": "Create a DSphere account record. Ordinary requests show a trusted inline chat form. Explicit generateDefaults delegation generates a name, encrypted password and permitted defaults, then saves directly. This never registers a third-party account; never pass passwords in tool input.",
  "inputSchema": {
    "type": "object",
    "description": "Create a DSphere account record. Ordinary requests show a trusted inline chat form. Explicit generateDefaults delegation generates a name, encrypted password and permitted defaults, then saves directly. This never registers a third-party account; never pass passwords in tool input.",
    "properties": {
      "generateDefaults": {
        "type": "boolean",
        "description": "True only when the person explicitly delegates generation of the account and all unspecified settings. Generate secrets locally and save directly without configuration, confirmation or password prompts; never overwrite an existing record."
      },
      "chooseAnyApplication": {
        "type": "boolean",
        "description": "Use true with generateDefaults for explicit requests like “随便挑一个应用创建” / “pick any application and create”. For a named application use its returned appId instead. Without this delegation an omitted appId opens an application picker."
      },
      "reviewConfiguration": {
        "type": "boolean",
        "description": "Show this application configuration as an inline card in the original AI conversation. Work and Sidepanel render every permission-derived field, choices and supported fingerprint metrics. The person selects values before confirmation and private password input; other supplied fields only prefill the form."
      },
      "appId": {
        "type": "string",
        "description": "Opaque application reference returned by accounts.options.get.",
        "minLength": 1,
        "maxLength": 100
      },
      "account": {
        "type": "string",
        "description": "Existing website account name.",
        "minLength": 1,
        "maxLength": 320
      },
      "loginType": {
        "type": "string",
        "description": "Application-supported login method.",
        "minLength": 1,
        "maxLength": 200
      },
      "remark": {
        "type": "string",
        "description": "Account remark.",
        "maxLength": 2000
      },
      "assigneeQuery": {
        "type": "string",
        "description": "The same user search used in options.get when choosing assigneeRefs.",
        "minLength": 1,
        "maxLength": 200
      },
      "assigneeRefs": {
        "type": "array",
        "description": "Explicitly selected assignment.choices references; never raw employee ids. Ask the person to select users or accept the returned defaults.",
        "items": {
          "type": "string",
          "description": "Opaque user reference from this application options.",
          "minLength": 1,
          "maxLength": 100
        },
        "minItems": 1,
        "maxItems": 100
      },
      "proxyRef": {
        "type": "string",
        "description": "Available proxy reference.",
        "minLength": 1,
        "maxLength": 100
      },
      "deviceRef": {
        "type": "string",
        "description": "Available device reference.",
        "minLength": 1,
        "maxLength": 100
      },
      "syncEnabled": {
        "type": "boolean",
        "description": "Whether to enable existing account synchronization when supported."
      },
      "sessionKeepAlive": {
        "type": "boolean",
        "description": "Whether to retain the existing account session."
      },
      "fingerprintPolicy": {
        "type": "string",
        "description": "Automatic generation follows the supported Work baseline; require rejects an unsupported app.",
        "minLength": 1,
        "maxLength": 200,
        "enum": [
          "auto",
          "require",
          "none"
        ]
      },
      "fingerprintOverrides": {
        "type": "object",
        "description": "Supported fingerprint fields; omitted fields retain their current value. Cookies and device credentials are never accepted.",
        "properties": {
          "language": {
            "type": "string",
            "description": "Browser languages, using the current Work format.",
            "maxLength": 200
          },
          "time_zone": {
            "type": "string",
            "description": "Timezone in the current Work format.",
            "maxLength": 100
          },
          "dnt": {
            "type": "string",
            "description": "Work Do Not Track setting.",
            "maxLength": 10
          },
          "battery": {
            "type": "string",
            "description": "Battery fingerprint setting; empty retains the disabled state.",
            "maxLength": 20
          },
          "font": {
            "type": "string",
            "description": "Font fingerprint value.",
            "maxLength": 20000
          },
          "bluetooth": {
            "type": "string",
            "description": "Bluetooth fingerprint value.",
            "maxLength": 20
          },
          "audio_context": {
            "type": "string",
            "description": "Audio fingerprint noise.",
            "maxLength": 20
          },
          "client_rects": {
            "type": "string",
            "description": "Client rectangles fingerprint noise.",
            "maxLength": 20
          },
          "media_device": {
            "type": "string",
            "description": "Media device fingerprint value.",
            "maxLength": 4000
          },
          "canvas": {
            "type": "string",
            "description": "Canvas fingerprint value.",
            "maxLength": 200
          },
          "webgl_image": {
            "type": "string",
            "description": "WebGL image fingerprint noise.",
            "maxLength": 30
          },
          "memory": {
            "type": "string",
            "description": "Device memory setting.",
            "maxLength": 20
          },
          "hardwareConcurrency": {
            "type": "string",
            "description": "Logical CPU count setting.",
            "maxLength": 20
          },
          "speech_voices": {
            "type": "string",
            "description": "Speech voices fingerprint value.",
            "maxLength": 20000
          },
          "screen_resolution_input": {
            "type": "string",
            "description": "Screen resolution in widthxheight format.",
            "maxLength": 40
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "description": "Account operation result. status/stage are for internal reconciliation, not user-facing open-success/failure badges. Report the separate autofill receipt; a page being open never proves fill or sign-in.",
    "properties": {
      "autofill": {
        "type": "object",
        "description": "Separate Biz autofill receipt. Query accounts.operations.get with operationId while running; unknown must not be replayed. succeeded proves fill owner completion, never website sign-in.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Observed autofill state.",
            "maxLength": 40,
            "enum": [
              "running",
              "succeeded",
              "failed",
              "skipped",
              "unknown"
            ]
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "description": "Receipt observation time in milliseconds."
          },
          "reason": {
            "type": "string",
            "description": "Safe reason code; never credentials or page field values.",
            "maxLength": 120
          }
        },
        "required": [
          "status",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "operationId": {
        "type": "string",
        "description": "Local operation reference; not a Pangu request receipt.",
        "maxLength": 100
      },
      "status": {
        "type": "string",
        "description": "Observed operation status.",
        "maxLength": 40,
        "enum": [
          "not-dispatched",
          "waiting-user",
          "running",
          "succeeded",
          "partial",
          "failed",
          "cancelled",
          "outcome-unknown",
          "record-unavailable",
          "available"
        ]
      },
      "stage": {
        "type": "string",
        "description": "Completed or current account business stage.",
        "maxLength": 100
      },
      "accountId": {
        "type": "string",
        "description": "Account reference when known.",
        "maxLength": 100
      },
      "pageContextId": {
        "type": "string",
        "description": "Actual opened/focused page reference when known.",
        "maxLength": 100
      },
      "warnings": {
        "type": "array",
        "description": "Bounded warnings, including synchronization and unknown outcomes.",
        "items": {
          "type": "string",
          "description": "One safe product warning.",
          "maxLength": 500
        },
        "maxItems": 20
      },
      "data": {
        "type": "object",
        "description": "Only the selected account operation's public product fields.",
        "properties": {
          "configuration": {
            "type": "object",
            "description": "Permission-derived account form. Work/Sidepanel render these fields; configurationText describes the same values to AI.",
            "additionalProperties": false,
            "required": [
              "fields",
              "blockedReasons"
            ],
            "properties": {
              "fields": {
                "type": "array",
                "description": "Permitted creation fields, including supported fingerprint metrics and their exact choices.",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "label",
                    "description",
                    "control",
                    "required"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "maxLength": 100,
                      "description": "Canonical creation field key used when submitting the selected value."
                    },
                    "label": {
                      "type": "object",
                      "description": "Localized product text in Chinese and English.",
                      "additionalProperties": false,
                      "required": [
                        "zh",
                        "en"
                      ],
                      "properties": {
                        "zh": {
                          "type": "string",
                          "maxLength": 200,
                          "description": "Chinese product text."
                        },
                        "en": {
                          "type": "string",
                          "maxLength": 200,
                          "description": "English product text."
                        }
                      }
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 1000,
                      "description": "Field meaning, permission conditions and selection guidance for the agent."
                    },
                    "control": {
                      "type": "string",
                      "description": "Product control type; private values are entered separately in the trusted credential window.",
                      "enum": [
                        "text",
                        "select",
                        "multiselect",
                        "boolean",
                        "private",
                        "group",
                        "override"
                      ]
                    },
                    "required": {
                      "type": "boolean",
                      "description": "Whether this field requires a value under the current application policy."
                    },
                    "allowCustom": {
                      "type": "boolean",
                      "description": "Whether values outside the listed choices may be entered."
                    },
                    "allowEmpty": {
                      "type": "boolean",
                      "description": "Whether an explicitly empty value is permitted."
                    },
                    "help": {
                      "type": "object",
                      "description": "Localized help for choosing or entering the field value.",
                      "additionalProperties": false,
                      "required": [
                        "zh",
                        "en"
                      ],
                      "properties": {
                        "zh": {
                          "type": "string",
                          "maxLength": 200,
                          "description": "Chinese product text."
                        },
                        "en": {
                          "type": "string",
                          "maxLength": 200,
                          "description": "English product text."
                        }
                      }
                    },
                    "emptyLabel": {
                      "type": "object",
                      "description": "Localized label explaining the empty-value choice.",
                      "additionalProperties": false,
                      "required": [
                        "zh",
                        "en"
                      ],
                      "properties": {
                        "zh": {
                          "type": "string",
                          "maxLength": 200,
                          "description": "Chinese product text."
                        },
                        "en": {
                          "type": "string",
                          "maxLength": 200,
                          "description": "English product text."
                        }
                      }
                    },
                    "format": {
                      "type": "string",
                      "description": "Additional validation format for a custom timezone or screen resolution.",
                      "enum": [
                        "timezone",
                        "resolution"
                      ]
                    },
                    "defaultDescription": {
                      "type": "string",
                      "maxLength": 1000,
                      "description": "Meaning of the default behavior when the field is left unchanged."
                    },
                    "searchKey": {
                      "type": "string",
                      "maxLength": 100,
                      "description": "Supported product search key for loading further permitted choices."
                    },
                    "maxLength": {
                      "type": "integer",
                      "description": "Maximum number of characters permitted for a text value.",
                      "minimum": 1,
                      "maximum": 20000
                    },
                    "defaultValue": {
                      "description": "Initial non-secret value selected by current application policy.",
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 20000,
                          "description": "Default text or option value."
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 100,
                            "description": "Default selected option value."
                          },
                          "maxItems": 100
                        }
                      ]
                    },
                    "options": {
                      "type": "array",
                      "description": "Choices currently permitted by application, license and resource permissions.",
                      "maxItems": 200,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "value",
                          "label"
                        ],
                        "properties": {
                          "value": {
                            "type": "string",
                            "maxLength": 200,
                            "description": "Exact option value accepted on submission."
                          },
                          "label": {
                            "type": "object",
